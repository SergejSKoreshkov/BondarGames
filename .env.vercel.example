# ----------------------------------------------------------------------
# Vercel — Development / Preview environment template
# ----------------------------------------------------------------------
# Copy each key into:
#   Vercel Dashboard → Project → Settings → Environment Variables
# and select the "Preview" (and/or "Development") environment for each.
#
# For Production, repeat with production-grade secrets and the prod URL.
# ----------------------------------------------------------------------

# --- Database (Neon Postgres) -----------------------------------------
# Provisioned automatically when you connect Neon via the Vercel
# Marketplace (Storage → Create Database → Neon). Both vars are injected
# by the integration — usually no need to set manually.
DATABASE_URL=""
DIRECT_URL=""

# --- NextAuth v5 ------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Vercel injects VERCEL_URL automatically; using its value here keeps
# preview deployments working without per-branch tweaks.
AUTH_URL="https://$VERCEL_URL"
AUTH_TRUST_HOST="true"

# --- Google OAuth -----------------------------------------------------
# https://console.cloud.google.com → APIs & Services → Credentials
# Add an Authorized redirect URI for every preview/prod domain you use:
#   https://<your-preview-or-prod-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Gmail SMTP (App Password) ----------------------------------------
# Requires 2-Step Verification on the Gmail account, then create an
# App Password at https://myaccount.google.com/apppasswords.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your.gmail@gmail.com"
SMTP_PASSWORD=""
SMTP_FROM="BondarGames <your.gmail@gmail.com>"

# --- App --------------------------------------------------------------
# Base URL used in confirmation email links. For preview deployments
# you can keep this in sync with VERCEL_URL:
APP_URL="https://$VERCEL_URL"
# First user signing up with this email becomes ADMIN
ADMIN_EMAIL=""
