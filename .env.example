# --- Database (Vercel Neon Postgres) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- NextAuth v5 ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Google OAuth ---
# https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Gmail SMTP (App Password required) ---
# https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your.gmail@gmail.com"
SMTP_PASSWORD="your-google-app-password"
SMTP_FROM="BondarGames <your.gmail@gmail.com>"

# --- App ---
APP_URL="http://localhost:3000"
# Email of the bootstrap admin user (first signup with this email becomes ADMIN)
ADMIN_EMAIL=""
